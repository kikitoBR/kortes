{
  "name": "kortes-desktop",
  "productName": "Kortes",
  "version": "0.1.0",
  "description": "Kortes: cortes de vídeo com IA no seu computador",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "site.kikito.kortes",
    "productName": "Kortes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app",
        "to": "app"
      },
      {
        "from": "runtime/python",
        "to": "python"
      },
      {
        "from": "runtime/postgres",
        "to": "postgres"
      },
      {
        "from": "runtime/redis",
        "to": "redis"
      },
      {
        "from": "runtime/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Kortes",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "kikitoBR",
      "repo": "kortes",
      "releaseType": "release"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
