{
  "name": "kortes",
  "productName": "Kortes",
  "version": "1.0.3",
  "description": "Kortes: cortes de vídeo com IA no seu computador",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "node scripts/prepare-app.mjs && electron-builder --win nsis --publish never",
    "release": "node scripts/prepare-app.mjs && electron-builder --win nsis --publish always",
    "prepare-app": "node scripts/prepare-app.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "site.kikito.kortes",
    "productName": "Kortes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app",
        "to": "app"
      },
      {
        "from": "runtime/python",
        "to": "python"
      },
      {
        "from": "runtime/postgres",
        "to": "postgres"
      },
      {
        "from": "runtime/redis",
        "to": "redis"
      },
      {
        "from": "runtime/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "runtime/deno",
        "to": "deno"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kortes",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "KortesSetup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "kikitoBR",
      "repo": "kortes-releases",
      "releaseType": "release"
    }
  }
}
