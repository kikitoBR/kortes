# Postgres (Neon pela Vercel Marketplace já preenche DATABASE_URL)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Senha do painel /painel (use uma longa)
ADMIN_PASSWORD=
# Opcional: assina o login do painel (padrão: deriva da senha; trocar a senha desconecta todos)
SESSION_SECRET=
# Servidor de licenças (gemini-web2api)
LICENSE_SERVER_URL=https://gemini.kikito.site/v1
# Opcional: avisa num canal do Discord quando chega mensagem de cliente
DISCORD_WEBHOOK_URL=
