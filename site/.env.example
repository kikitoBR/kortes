# Postgres (Neon pela Vercel Marketplace já preenche DATABASE_URL)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Senha do painel /painel (use uma longa)
ADMIN_PASSWORD=
# Opcional: assina o login do painel (padrão: deriva da senha; trocar a senha desconecta todos)
SESSION_SECRET=
# Servidor de licenças (gemini-web2api)
LICENSE_SERVER_URL=https://gemini.kikito.site/v1
# Opcional: avisa num canal do Discord quando chega mensagem de cliente
DISCORD_WEBHOOK_URL=

# --- Contas do app (login com e-mail e senha) ---
# Token de admin do servidor de licenças (ADMIN_TOKEN do gemini-web2api): cria e troca a chave de cada conta
LICENSE_ADMIN_TOKEN=
# Opcional: endereço do admin (padrão: LICENSE_SERVER_URL sem o /v1)
LICENSE_ADMIN_URL=
# Opcional: plano grátis = FREE_CLIPS cortes por computador (padrão 15), até FREE_CLIPS_PER_VIDEO por vídeo
# ou live (padrão 5); tokens de IA por mês do plano grátis (padrão 4000000)
FREE_CLIPS=
FREE_CLIPS_PER_VIDEO=
FREE_MONTHLY_TOKENS=
# E-mail de "esqueci a senha": SMTP (ex. a caixa de e-mail da Hostinger) OU a Resend.
# Sem nenhum dos dois, o link sai só no log da Vercel.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responda@kortes.com.br
SMTP_PASS=
RESEND_API_KEY=
# Remetente (padrão: o SMTP_USER)
MAIL_FROM=Kortes <nao-responda@kortes.com.br>
SITE_URL=https://kortes.com.br

# --- Kirvano ---
# Token do webhook (o mesmo cadastrado na Kirvano). Sem ele, nenhuma compra libera plano.
KIRVANO_WEBHOOK_TOKEN=
# Opcional: id da oferta -> plano, ex. {"abc":"monthly","def":"yearly","ghi":"lifetime"} (sem isso, vale o nome do produto)
KIRVANO_PLANS=
# Links do checkout de cada plano (botões de /planos; vazio mostra "Em breve"). Trocar exige novo deploy.
KIRVANO_CHECKOUT_MONTHLY=
KIRVANO_CHECKOUT_YEARLY=
KIRVANO_CHECKOUT_LIFETIME=
